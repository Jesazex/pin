{%if settings.dgHomeLink === true%}
    <nav class="navbar">
        <div class="navbar-inner">
            {% if meta.siteLogoPath %}
            <a href="/" style="text-decoration: none;">
                <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{meta.siteName}}">
            </a>
            {% endif %}
        </div>
        <div class="navbar-actions">
            {% set slotName = "navbar.actions" %}{% include "components/pluginSlot.njk" %}
            {% include "components/pagePanelButton.njk" %}
        </div>
    </nav>
    {%else%}
    <div class="empty-navbar" >
        {% set slotName = "navbar.actions" %}{% include "components/pluginSlot.njk" %}
    </div>
{%endif%}