{#- Apply pinned panel state on <html> before first paint to avoid open→close flash. -#}
<script>
(function () {
      var LEFT_KEY = 'dg-left-panel-collapsed';
      var RIGHT_KEY = 'dg-right-panel-collapsed';
      var html = document.documentElement;

      try {
            var compact = window.matchMedia('(max-width: 1000px)').matches;
            var leftRaw = sessionStorage.getItem(LEFT_KEY);
            var rightRaw = sessionStorage.getItem(RIGHT_KEY);
            // Both panels stay closed until the reader opens them.
            var leftCollapsed = leftRaw !== '0';
            var rightCollapsed = rightRaw !== '0';
            // Mobile: only one panel open at a time.
            if (compact && !leftCollapsed && !rightCollapsed) {
                  rightCollapsed = true;
            }
            // Do not paint a quarter-width drawer before the labels are
            // measured. That width shows for a moment on refresh and when
            // opening a note. The panels stay hidden until the fit script
            // publishes the real width.
            html.classList.add('dg-panel-sizing');
            html.classList.toggle('left-panel-collapsed', leftCollapsed);
            html.classList.toggle('right-panel-collapsed', rightCollapsed);
            html.classList.toggle('compact-panels', compact);
            setTimeout(function () {
                  html.classList.remove('dg-panel-sizing');
            }, 1200);
      } catch (e) {
            html.classList.add('left-panel-collapsed', 'right-panel-collapsed');
      }
      html.classList.add('dg-panel-boot');
      html.classList.add('dg-math-pending');
})();
</script>
