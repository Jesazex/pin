{%- set deadlines = userComputed.controlDeadlines if userComputed else [] -%}
{%- if deadlines and deadlines.length -%}
<noscript><style>[data-dg-deadlines]{visibility:visible !important}</style></noscript>
<div class="deadlines-block" id="dg-deadlines" data-dg-deadlines style="visibility:hidden">
  {%- for line in deadlines -%}
  <div class="deadline-line">
    <span class="deadline-label">{{ line.label }}</span>
    <span class="deadline-detail">
      {%- for subject in line.subjects -%}
      <a class="deadline-subject" href="{{ subject.href }}">{{ subject.subjectName }}</a>{%- if not loop.last -%}, {% endif %}
      {%- endfor -%}
      <span class="deadline-when"> - {{ line.whenText }}</span>
    </span>
    {%- if line.tomorrow and line.tomorrow.subjects.length -%}
    <span class="deadline-detail">
      {%- for subject in line.tomorrow.subjects -%}
      <a class="deadline-subject" href="{{ subject.href }}">{{ subject.subjectName }}</a>{%- if not loop.last -%}, {% endif %}
      {%- endfor -%}
      <span class="deadline-when"> - {{ line.tomorrow.whenText }}</span>
    </span>
    {%- endif -%}
  </div>
  {%- endfor -%}
  <button type="button" class="deadline-table-open">Таблица дедлайнов</button>
</div>
<script>
(function () {
  {{ userComputed.deadlinesClientSource | safe }}
  var block = document.getElementById("dg-deadlines");
  if (!block) {
    var script = document.currentScript;
    block = script && script.previousElementSibling;
  }
  if (!block || typeof dgDeadlinesApi === "undefined") return;

  function subjectLink(subject) {
    var link = document.createElement("a");
    link.className = "deadline-subject";
    link.href = subject.href;
    link.textContent = subject.subjectName;
    return link;
  }

  function appendDetail(row, subjects, whenText) {
    var detail = document.createElement("span");
    detail.className = "deadline-detail";
    var list = subjects || [];
    for (var i = 0; i < list.length; i++) {
      if (i > 0) detail.appendChild(document.createTextNode(", "));
      detail.appendChild(subjectLink(list[i]));
    }
    var when = document.createElement("span");
    when.className = "deadline-when";
    when.textContent = " - " + (whenText || "");
    detail.appendChild(when);
    row.appendChild(detail);
  }

  function renderLine(line) {
    var row = document.createElement("div");
    row.className = "deadline-line";
    var label = document.createElement("span");
    label.className = "deadline-label";
    label.textContent = line.label;
    row.appendChild(label);
    appendDetail(row, line.subjects, line.whenText);
    if (line.tomorrow && line.tomorrow.subjects && line.tomorrow.subjects.length) {
      appendDetail(row, line.tomorrow.subjects, line.tomorrow.whenText);
    }
    return row;
  }

  function columnsByNearest(columns, rows) {
    var rank = {};
    var i;
    var name;
    for (i = 0; i < columns.length; i++) rank[columns[i]] = rows.length + 1;
    for (i = 0; i < rows.length; i++) {
      var cells = rows[i].cells || {};
      for (name in cells) {
        if (!Object.prototype.hasOwnProperty.call(cells, name)) continue;
        if (cells[name] && cells[name].length && rank[name] > i) rank[name] = i;
      }
    }
    return columns.slice().sort(function (a, b) {
      return rank[a] - rank[b] || String(a).localeCompare(String(b), "ru");
    });
  }

  function renderTable(table) {
    var columns = columnsByNearest(table.columns || [], table.rows || []);
    var rows = table.rows || [];
    var tableEl = document.createElement("table");
    var head = document.createElement("thead");
    var headRow = document.createElement("tr");
    var weekHead = document.createElement("th");
    weekHead.scope = "col";
    weekHead.className = "deadline-week-head";
    weekHead.setAttribute("aria-label", "Неделя");
    headRow.appendChild(weekHead);
    var corner = document.createElement("th");
    corner.scope = "col";
    corner.textContent = "Дата";
    headRow.appendChild(corner);
    for (var c = 0; c < columns.length; c++) {
      var th = document.createElement("th");
      th.scope = "col";
      th.textContent = columns[c];
      headRow.appendChild(th);
    }
    head.appendChild(headRow);
    tableEl.appendChild(head);
    var body = document.createElement("tbody");
    var r = 0;
    while (r < rows.length) {
      var span = 1;
      var week = rows[r].week;
      while (r + span < rows.length && rows[r + span].week === week) span++;
      for (var i = 0; i < span; i++) {
        var tr = document.createElement("tr");
        if (i === 0) {
          var weekCell = document.createElement("th");
          weekCell.scope = "rowgroup";
          weekCell.rowSpan = span;
          weekCell.className = "deadline-week";
          var weekText = document.createElement("span");
          weekText.className = "deadline-week-label";
          var weekInner = document.createElement("span");
          weekInner.className = "deadline-week-text";
          var weekFull = rows[r].weekLabel || (week + " неделя");
          weekInner.textContent = weekFull;
          weekInner.title = weekFull;
          weekText.appendChild(weekInner);
          weekCell.appendChild(weekText);
          tr.appendChild(weekCell);
        }
        var dateCell = document.createElement("th");
        dateCell.scope = "row";
        dateCell.textContent = rows[r + i].label;
        tr.appendChild(dateCell);
        for (var k = 0; k < columns.length; k++) {
          var td = document.createElement("td");
          var items = (rows[r + i].cells && rows[r + i].cells[columns[k]]) || [];
          for (var s = 0; s < items.length; s++) td.appendChild(subjectLink(items[s]));
          tr.appendChild(td);
        }
        if (i === span - 1 && r + span < rows.length) tr.className = "deadline-week-end";
        body.appendChild(tr);
      }
      if (r + span < rows.length) {
        var rule = document.createElement("tr");
        rule.className = "deadline-week-rule";
        var ruleCell = document.createElement("td");
        ruleCell.colSpan = columns.length + 2;
        rule.appendChild(ruleCell);
        body.appendChild(rule);
      }
      r += span;
    }
    tableEl.appendChild(body);
    return tableEl;
  }

  function closeTable() {
    var overlay = document.getElementById("dg-deadline-table");
    if (overlay) {
      if (overlay._deadlineUnbind) overlay._deadlineUnbind();
      overlay.remove();
    }
    document.removeEventListener("keydown", onTableKey);
  }

  function onTableKey(event) {
    if (event.key === "Escape") closeTable();
  }

  function clipWeekLabels(tableEl) {
    if (!tableEl) return;
    var nodes = tableEl.querySelectorAll(".deadline-week-text");
    var i;
    for (i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      var full = el.getAttribute("data-full") || el.title || el.textContent;
      el.setAttribute("data-full", full);
      el.title = full;
      el.textContent = full;
      el.style.maxHeight = "none";
      var needed = el.getBoundingClientRect().height;
      var available = el.parentElement.getBoundingClientRect().height;
      el.style.maxHeight = "";
      if (needed <= available + 1) continue;
      var lo = 1;
      var hi = full.length;
      var best = "…";
      while (lo <= hi) {
        var mid = (lo + hi) >> 1;
        var next = full.slice(0, mid).replace(/[\s(]+$/, "") + "…";
        el.textContent = next;
        el.style.maxHeight = "none";
        var height = el.getBoundingClientRect().height;
        el.style.maxHeight = "";
        if (height <= available + 1) {
          best = next;
          lo = mid + 1;
        } else {
          hi = mid - 1;
        }
      }
      el.textContent = best;
    }
  }

  function fitDeadlineWindow(scroll, tableEl) {
    if (!scroll || !tableEl) return;
    var maxW = Math.max(160, window.innerWidth - 48);
    var maxH = Math.max(120, Math.min(window.innerHeight * 0.85, window.innerHeight - 48));
    var rect = tableEl.getBoundingClientRect();
    var w = Math.ceil(rect.width);
    var h = Math.ceil(rect.height);
    scroll.style.width = Math.min(w, maxW) + "px";
    scroll.style.height = Math.min(h, maxH) + "px";
    var barX = scroll.offsetWidth - scroll.clientWidth;
    if (barX > 0 && w + barX <= maxW) scroll.style.width = (w + barX) + "px";
    var barY = scroll.offsetHeight - scroll.clientHeight;
    if (barY > 0 && h + barY <= maxH) scroll.style.height = (h + barY) + "px";
  }

  function bindDeadlinePinch(scroll, onScale) {
    var query = window.matchMedia("(max-width: 1000px)");
    var table = scroll.querySelector("table");
    if (!table) return;
    var scale = 1;
    var startDist = 0;
    var startScale = 1;

    function distance(touches) {
      var dx = touches[0].clientX - touches[1].clientX;
      var dy = touches[0].clientY - touches[1].clientY;
      return Math.sqrt(dx * dx + dy * dy) || 1;
    }

    function applyScale(next) {
      if (next < 0.5) next = 0.5;
      if (next > 3) next = 3;
      scale = next;
      table.style.zoom = String(scale);
      if (onScale) onScale();
    }

    scroll.addEventListener("touchstart", function (event) {
      if (!query.matches || event.touches.length !== 2) return;
      startDist = distance(event.touches);
      startScale = scale;
    }, { passive: true });

    scroll.addEventListener("touchmove", function (event) {
      if (!query.matches || event.touches.length !== 2 || !startDist) return;
      event.preventDefault();
      applyScale(startScale * (distance(event.touches) / startDist));
    }, { passive: false });

    function endPinch(event) {
      if (!event.touches || event.touches.length < 2) startDist = 0;
    }

    scroll.addEventListener("touchend", endPinch);
    scroll.addEventListener("touchcancel", endPinch);
  }

  function openTable(table) {
    closeTable();
    var overlay = document.createElement("div");
    overlay.id = "dg-deadline-table";
    overlay.className = "deadline-table-overlay";
    var panel = document.createElement("div");
    panel.className = "deadline-table-panel";
    panel.setAttribute("role", "dialog");
    panel.setAttribute("aria-label", "Таблица дедлайнов");
    var close = document.createElement("button");
    close.type = "button";
    close.className = "deadline-table-close";
    close.setAttribute("aria-label", "Закрыть");
    close.textContent = "×";
    close.addEventListener("click", closeTable);
    var scroll = document.createElement("div");
    scroll.className = "deadline-table-scroll";
    var tableEl = null;
    if (!table.rows || !table.rows.length) {
      var empty = document.createElement("p");
      empty.className = "deadline-table-empty";
      empty.textContent = "Нет предстоящих дат";
      scroll.appendChild(empty);
    } else {
      tableEl = renderTable(table);
      scroll.appendChild(tableEl);
    }
    panel.appendChild(scroll);
    overlay.appendChild(panel);
    overlay.appendChild(close);
    function placeClose() {
      var panelRect = panel.getBoundingClientRect();
      var overlayRect = overlay.getBoundingClientRect();
      var top = panelRect.top - overlayRect.top - close.offsetHeight - 2;
      if (top < 4) top = panelRect.top - overlayRect.top + 4;
      close.style.top = top + "px";
      close.style.left = (panelRect.right - overlayRect.left - close.offsetWidth) + "px";
      close.style.right = "auto";
    }
    overlay.addEventListener("click", function (event) {
      if (event.target === overlay) closeTable();
    });
    document.body.appendChild(overlay);
    clipWeekLabels(tableEl);
    function refit() {
      fitDeadlineWindow(scroll, tableEl);
      placeClose();
    }
    refit();
    window.addEventListener("resize", refit);
    overlay._deadlineUnbind = function () {
      window.removeEventListener("resize", refit);
    };
    bindDeadlinePinch(scroll, refit);
    document.addEventListener("keydown", onTableKey);
    close.focus();
  }

  try {
    var candidates = {{ userComputed.controlDeadlineCandidatesJson | safe }};
    var lines = dgDeadlinesApi.pickControlDeadlines(candidates);
    var table = dgDeadlinesApi.buildDeadlineTable(candidates);
    var rows = [];
    for (var i = 0; i < lines.length; i++) rows.push(renderLine(lines[i]));
    if (rows.length) {
      block.textContent = "";
      for (var j = 0; j < rows.length; j++) block.appendChild(rows[j]);
      var opener = document.createElement("button");
      opener.type = "button";
      opener.className = "deadline-table-open";
      opener.textContent = "Таблица дедлайнов";
      opener.addEventListener("click", function () { openTable(table); });
      block.appendChild(opener);
    }
  } catch (err) {}
  block.style.visibility = "visible";
  if (window.dgSyncFiletreeDeadlines) window.dgSyncFiletreeDeadlines();
})();
</script>
{%- endif -%}
