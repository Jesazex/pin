<script>
  window.umamiConfig = {
    beforeSend: function (type, payload) {
      if (!payload) return payload;
      // Обнуляем разрешение экрана, язык браузера и источник перехода (referrer)
      delete payload.screen;
      delete payload.language;
      delete payload.referrer;
      return payload;
    }
  };
</script>
