{% if settings.dgEnableSearch === true %}
<div class="search-container" id="globalsearch" onclick="toggleSearch()">
    <div class="search-box" onclick="event.stopPropagation()">
        <div class="search-header">
            <input type="search" id="term" placeholder="{{ meta.uiStrings.searchPlaceholder }}">
        </div>

        <div class="search-layout no-preview" id="search-layout">
            <div class="search-results-panel" id="search-results"></div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/flexsearch@0.7.21/dist/flexsearch.bundle.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', init, false);
    document.addEventListener('DOMContentLoaded', setCorrectShortcut, false);

    function clearSearchQuery() {
        const field = document.getElementById('term');
        if (field) field.value = '';
        const results = document.getElementById('search-results');
        if (results) results.innerHTML = "";
        window.lastSearch = '';
        window.searchResults = [];
        window.searchTerms = [];
    }

    window.toggleSearch = function () {
        const searchContainer = document.getElementById('globalsearch');
        if (searchContainer.classList.contains('active')) {
            searchContainer.classList.remove('active');
            clearSearchQuery();
        } else {
            searchContainer.classList.add('active');
            document.getElementById('term').focus();
        }
    }

    window.openSiteSearch = function () {
        const searchContainer = document.getElementById('globalsearch');
        const field = document.getElementById('term');
        if (!searchContainer || !field) return;
        if (!searchContainer.classList.contains('active')) {
            searchContainer.classList.add('active');
        }
        field.focus();
        field.select();
    }

    document.addEventListener('keydown', function (event) {
        if (event.altKey || event.shiftKey) return;
        if (!(event.ctrlKey || event.metaKey)) return;
        if (event.key !== 'f' && event.key !== 'F') return;
        event.preventDefault();
        window.openSiteSearch();
    }, true);

    window.toggleTagSearch = function (evt) {
        const term = evt.textContent;
        if (term) {
            document.getElementById('term').value = term.trim();
            window.toggleSearch();
            window.search();
        }
    }

    function debounce(func, wait, immediate) {
        var timeout;
        return function () {
            var context = this, args = arguments;
            var later = function () {
                timeout = null;
                if (!immediate) func.apply(context, args);
            };
            var callNow = immediate && !timeout;
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
            if (callNow) func.apply(context, args);
        };
    }

    function setCorrectShortcut() {
        if (navigator.platform.toUpperCase().indexOf('MAC') >= 0) {
            document.querySelectorAll(".search-keys").forEach(x => x.innerHTML = "<code>⌘</code>&nbsp;+&nbsp;<code>K</code>");
        }
    }

    // ===== Highlighting Utilities =====

    function tokenizeSearchTerms(query) {
        const terms = [];
        const regex = /"([^"]+)"|(\S+)/g;
        let match;
        while ((match = regex.exec(query)) !== null) {
            const term = (match[1] || match[2]).toLowerCase();
            if (term.length > 1) {
                terms.push(term);
            }
        }
        return terms.sort((a, b) => b.length - a.length);
    }

    function highlightTerms(text, terms) {
        if (!terms || terms.length === 0 || !text) return text;
        let result = text;
        terms.forEach(term => {
            const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const regex = new RegExp(`(${escaped})`, 'gi');
            result = result.replace(regex, '<span class="search-highlight">$1</span>');
        });
        return result;
    }

    function getContextualExcerpt(content, terms, maxLength = 150) {
        if (!content) return '';
        const plainText = content.replace(/<[^>]*>/g, '');

        if (!terms || terms.length === 0) {
            return truncateText(plainText, maxLength);
        }

        let firstMatchIndex = plainText.length;
        terms.forEach(term => {
            const index = plainText.toLowerCase().indexOf(term.toLowerCase());
            if (index !== -1 && index < firstMatchIndex) {
                firstMatchIndex = index;
            }
        });

        if (firstMatchIndex === plainText.length) {
            return truncateText(plainText, maxLength);
        }

        const contextBefore = 50;
        const start = Math.max(0, firstMatchIndex - contextBefore);
        const end = Math.min(plainText.length, start + maxLength);

        let excerpt = plainText.substring(start, end);
        if (start > 0) excerpt = '...' + excerpt;
        if (end < plainText.length) excerpt = excerpt + '...';

        return excerpt;
    }

    function truncateText(str, size) {
        if (!str) return '';
        str = str.replace(/<[^>]*>/g, '');
        if (str.length <= size) return str;
        return str.substring(0, size - 3) + '...';
    }

    // ===== FlexSearch Index =====

    function createIndex(posts) {
        const normalizeForSearch = (str) => str
            .toLowerCase()
            // á -> a +  ́
            .normalize("NFD")
            // n~ -> ñ
            .replace(/n\u0303/g, "ñ")
            // áéíóúü -> aeiouu
            .replace(/[\u0300-\u036f]/g, "")
            // Recompose Unicode
            .normalize("NFC");

        const encoder = (str) => normalizeForSearch(str)
            .split(/([^a-z]|[^\x00-\x7F])/);
        const contentIndex = new FlexSearch.Document({
            cache: true,
            charset: "latin:extra",
            optimize: true,
            index: [
                { field: "content", tokenize: "reverse", encode: encoder },
                { field: "title", tokenize: "forward", encode: encoder },
                { field: "tags", tokenize: "forward", encode: encoder }
            ]
        });
        posts.forEach((p, idx) => {
            contentIndex.add({ id: idx, title: p.title, content: p.content, tags: p.tags });
        });
        return contentIndex;
    }

    // ===== Initialization =====

    async function init() {
        // Fetch search index (browser caches based on query param)
        const docs = await fetch('/searchIndex.json?v={{meta.buildDate|isoDate}}').then(r => r.json());
        const index = createIndex(docs);
        window.docs = docs;
        window.index = index;

        // Keyboard shortcuts
        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                toggleSearch();
            }
            if (e.key === 'Escape') {
                const searchContainer = document.getElementById('globalsearch');
                if (searchContainer && searchContainer.classList.contains('active')) {
                    searchContainer.classList.remove('active');
                    clearSearchQuery();
                }
            }

            // Navigate search results with arrow keys
            if (document.getElementById('globalsearch').classList.contains('active')) {
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    navigateResults(1);
                }
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    navigateResults(-1);
                }
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const active = document.querySelector('.searchresult.active');
                    if (active) {
                        const url = active.dataset.url;
                        if (url) window.location.href = url;
                    }
                }
            }
        });

        function navigateResults(direction) {
            const results = document.querySelectorAll('.searchresult');
            if (results.length === 0) return;

            let currentIndex = -1;
            results.forEach((el, i) => {
                if (el.classList.contains('active')) {
                    currentIndex = i;
                }
            });

            let newIndex;
            if (currentIndex === -1) {
                newIndex = direction > 0 ? 0 : results.length - 1;
            } else {
                newIndex = currentIndex + direction;
                if (newIndex < 0) newIndex = results.length - 1;
                if (newIndex >= results.length) newIndex = 0;
            }

            results.forEach(el => el.classList.remove('active'));
            results[newIndex].classList.add('active');
            results[newIndex].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        const debouncedSearch = debounce(search, 200, false);
        window.field = document.querySelector('#term');
        field.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp' && e.key !== 'Enter') {
                debouncedSearch();
            }
        });
        window.resultsDiv = document.querySelector('#search-results');

        const params = new URL(location.href).searchParams;
        if (params.get('q')) {
            field.setAttribute('value', params.get('q'));
            toggleSearch();
            search();
        }
    }

    // ===== Search Function =====

    window.lastSearch = '';
    window.searchResults = [];
    window.searchTerms = [];

    async function search() {
        const searchQuery = field.value.trim();

        if (!searchQuery) {
            resultsDiv.innerHTML = "";
            return;
        }

        window.lastSearch = searchQuery;
        window.searchTerms = searchTermsFor(searchQuery);

        const results = offlineSearch(searchQuery);
        window.searchResults = results;

        if (!results.length) {
            resultsDiv.innerHTML = `
                <div class="no-results">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                    <p>{{ meta.uiStrings.searchNoResults }} "${searchQuery}"</p>
                </div>
            `;
            return;
        }

        let resultsHTML = '';
        results.forEach((r, index) => {
            const excerpt = getContextualExcerpt(r.content, window.searchTerms, 120);
            const highlightedExcerpt = highlightTerms(excerpt, window.searchTerms);
            const highlightedTitle = highlightTerms(r.title, window.searchTerms);
            const targetUrl = r.matchId ? `${r.url}#${encodeURIComponent(r.matchId)}` : r.url;

            const tagsHTML = r.tags && r.tags.length > 0
                ? `<div class="result-tags">${r.tags.map(tag => `<span class="tag">#${tag}</span>`).join('')}</div>`
                : '';

            resultsHTML += `
                <div class="searchresult${index === 0 ? ' active' : ''}"
                     data-index="${index}"
                     data-url="${targetUrl}"
                     onclick="window.location.href='${targetUrl}'">
                    <span class="result-title">${highlightedTitle}</span>
                    ${tagsHTML}
                    <div class="result-excerpt">${highlightedExcerpt}</div>
                </div>
            `;
        });

        resultsDiv.innerHTML = resultsHTML;
    }

    window.search = search;

    // ===== Offline Search =====

    function normalizePhrase(str) {
        return String(str || "")
            .toLowerCase()
            .replace(/\s+/g, " ")
            .trim();
    }

    // Physical keys of the Russian ЙЦУКЕН layout and their English QWERTY letters.
    const LAYOUT_FROM = "qwertyuiop[]asdfghjkl;'zxcvbnm`,.QWERTYUIOP{}ASDFGHJKL:\"ZXCVBNM~<>";
    const LAYOUT_TO = "йцукенгшщзхъфывапролджэячсмитьёбюЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬЁБЮ";
    const LAYOUT_SWAP = {};
    for (let layoutIndex = 0; layoutIndex < LAYOUT_FROM.length; layoutIndex++) {
        LAYOUT_SWAP[LAYOUT_FROM[layoutIndex]] = LAYOUT_TO[layoutIndex];
        LAYOUT_SWAP[LAYOUT_TO[layoutIndex]] = LAYOUT_FROM[layoutIndex];
    }

    function swapLayout(text) {
        const source = String(text || "");
        let swapped = "";
        for (let i = 0; i < source.length; i++) {
            const ch = source[i];
            swapped += Object.prototype.hasOwnProperty.call(LAYOUT_SWAP, ch) ? LAYOUT_SWAP[ch] : ch;
        }
        return swapped;
    }

    function phraseVariants(query) {
        const phrase = normalizePhrase(query);
        if (!phrase) return [];
        const alternate = normalizePhrase(swapLayout(query));
        if (alternate && alternate !== phrase) return [phrase, alternate];
        return [phrase];
    }

    function searchTermsFor(query) {
        const trimmed = String(query || "").trim();
        if (trimmed[0] === "#" && trimmed.length > 1) {
            return tokenizeSearchTerms(trimmed.substring(1));
        }
        return phraseVariants(trimmed);
    }

    function phraseInText(text, phrase) {
        return normalizePhrase(text).includes(phrase);
    }

    // Exact phrase. A heading inside the note ranks above body-only matches.
    // The file name is not a heading. A file without the phrase is omitted.
    function offlineSearch(searchQuery) {
        const data = window.docs || [];
        const isTagSearch = searchQuery[0] === "#" && searchQuery.length > 1;

        if (isTagSearch) {
            const searchResults = index.search(searchQuery.substring(1), [{ field: "tags" }]);
            const tagHit = searchResults.find((x) => x.field === "tags");
            const ids = tagHit ? tagHit.result : [];
            return ids.map((id) => {
                const result = { ...data[id] };
                result.tags = (result.tags || []).filter((x) => x !== "gardenEntry" && x !== "note");
                return result;
            });
        }

        const phrases = phraseVariants(searchQuery);
        if (!phrases.length) return [];

        // The layout the user actually typed comes first. Inside each layout,
        // a heading match still outranks a body-only match.
        const groups = phrases.map(function () {
            return { heading: [], text: [] };
        });
        data.forEach((doc) => {
            for (let i = 0; i < phrases.length; i++) {
                const located = locatePhrase(doc, phrases[i]);
                if (!located) continue;
                const result = { ...doc };
                result.tags = (result.tags || []).filter((x) => x !== "gardenEntry" && x !== "note");
                result.matchId = located.matchId;
                if (located.inHeading) groups[i].heading.push(result);
                else groups[i].text.push(result);
                break;
            }
        });

        let ordered = [];
        groups.forEach(function (group) {
            ordered = ordered.concat(group.heading, group.text);
        });
        return ordered;
    }

    // Scroll target is a heading inside the note, never the file name.
    // If any heading title contains the phrase, open that heading — even when
    // the phrase also occurs in the body. If it occurs only in the body, open
    // the heading of the section that contains it.
    function locatePhrase(doc, phrase) {
        const sections = Array.isArray(doc.sections) ? doc.sections : [];
        let headingId = "";
        let textId = "";
        let inHeading = false;
        let inText = false;

        for (const section of sections) {
            const id = section.id && section.id !== "note-title" ? section.id : "";
            const headingHit = phraseInText(section.text, phrase);
            const bodyHit = phraseInText(section.body, phrase);
            if (headingHit) {
                inHeading = true;
                if (!headingId && id) headingId = id;
            }
            if (bodyHit) {
                inText = true;
                if (!textId && id) textId = id;
            }
        }

        const titleHit = phraseInText(doc.title, phrase);
        if (!inHeading && !inText && (titleHit || phraseInText(doc.content, phrase))) {
            inText = true;
        }
        if (!inHeading && !inText) return null;
        return { inHeading, matchId: headingId || textId || "" };
    }

    // Tags rendered by the core (note content, header tags, canvas nodes)
    // carry no inline handler — one delegated listener opens a tag search
    // for any of them. Tags inside the search UI keep their own handlers.
    document.addEventListener('click', function (e) {
        const tagEl = e.target.closest('a.tag');
        if (!tagEl || tagEl.closest('#globalsearch')) return;
        const href = tagEl.getAttribute('href');
        if (href && href !== 'javascript:void(0);') return;
        window.toggleTagSearch(tagEl);
    });
</script>
{% endif %}
